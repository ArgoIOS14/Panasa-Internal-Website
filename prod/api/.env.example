# ============================================================
# Panasa Website — Zoho Bigin API Credentials
# ============================================================
# This file is a TEMPLATE. Do NOT edit this file directly.
#
# DEPLOYMENT STEP:
# 1. Copy this file to `.env` in the same directory:
#      cp .env.example .env
# 2. Replace the placeholder values below with real credentials
#    (ask the site owner / project lead for the actual values)
# 3. Set file permissions to 640:
#      chmod 640 .env
# 4. Verify it's blocked from public access:
#      curl https://www.panasatech.com/api/.env  → should return 403
#
# The contact form and email capture will fail with "Server
# configuration missing" if this file is absent or has wrong values.
# ============================================================

ZOHO_CLIENT_ID=<paste-from-zoho-api-console>
ZOHO_CLIENT_SECRET=<paste-from-zoho-api-console>
ZOHO_REFRESH_TOKEN=<paste-from-zoho-api-console>

# Zoho India data centre (default). For US/EU, change the .in to .com or .eu
ZOHO_ACCOUNTS_URL=https://accounts.zoho.in/oauth/v2/token
ZOHO_BIGIN_API_URL=https://www.zohoapis.in/bigin/v2/Contacts
