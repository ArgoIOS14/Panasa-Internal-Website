RewriteEngine On

# ── Enforce www prefix ───────────────────────────────────
RewriteCond %{HTTP_HOST} ^panasatech\.com$ [NC]
RewriteRule ^(.*)$ https://www.panasatech.com/$1 [R=301,L]

# ── Clean URLs: strip .html extension ────────────────────
# If the request is not a file or directory, try adding .html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+)$ $1.html [L]

# Redirect .html URLs to clean versions (301 for SEO)
RewriteCond %{THE_REQUEST} \s/(.+?)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# ── Redirect old WordPress URLs (trailing slash) ────────
Redirect 301 /about/ /about
Redirect 301 /careers/ /careers
Redirect 301 /contact/ /contact
Redirect 301 /services/ /services
Redirect 301 /privacy-policy/ /privacy-policy

# ── Redirect old query-param service URLs ────────────────
RewriteCond %{QUERY_STRING} service=ai-governance
RewriteRule ^services(\.html)?$ /ai-governance? [R=301,L]

RewriteCond %{QUERY_STRING} service=intelligent-operations
RewriteRule ^services(\.html)?$ /intelligent-operations? [R=301,L]

RewriteCond %{QUERY_STRING} service=ai-powered-legacy-modernisation
RewriteRule ^services(\.html)?$ /ai-powered-legacy-modernisation? [R=301,L]

RewriteCond %{QUERY_STRING} service=ai-accelerated-fintech-engineering
RewriteRule ^services(\.html)?$ /ai-accelerated-fintech-engineering? [R=301,L]
