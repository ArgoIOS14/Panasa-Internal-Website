{
  "rules": {
    ".read": false,
    ".write": false,

    "users": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('active').val() === true",
      "$uid": {
        ".read": "auth != null && $uid === auth.uid",
        ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'superadmin' || (!data.exists() && auth.uid === $uid && newData.child('email').val() === auth.token.email && ((newData.child('role').val() === 'superadmin' && auth.token.email === 'arjun.g@panasatech.com') || (newData.child('_claimedInvite').isString() && root.child('invites').child(newData.child('_claimedInvite').val()).child('email').val() === auth.token.email && root.child('invites').child(newData.child('_claimedInvite').val()).child('role').val() === newData.child('role').val()))))",
        ".validate": "newData.hasChildren(['email','role','active'])",
        "role": { ".validate": "newData.val() === 'superadmin' || newData.val() === 'approver' || newData.val() === 'editor'" },
        "email": { ".validate": "newData.isString()" },
        "active": { ".validate": "newData.isBoolean()" },
        "createdAt": { ".validate": "newData.isNumber()" },
        "lastActive": { ".validate": "newData.isNumber()" },
        "invitedBy": { ".validate": "newData.isString()" },
        "_claimedInvite": { ".validate": "newData.isString() || !newData.exists()" },
        "$other": { ".validate": true }
      }
    },

    "invites": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'superadmin'",
      "$key": {
        ".read": "auth != null && data.child('email').val() === auth.token.email",
        ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'superadmin' || (data.exists() && data.child('email').val() === auth.token.email && !newData.exists()))",
        ".validate": "newData.hasChildren(['email','role']) || !newData.exists()"
      }
    },

    "pages": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('active').val() === true",
      "$pageKey": {
        ".write": "auth != null && root.child('users').child(auth.uid).child('active').val() === true && (root.child('users').child(auth.uid).child('role').val() === 'superadmin' || root.child('users').child(auth.uid).child('role').val() === 'approver')"
      }
    },

    "drafts": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('active').val() === true",
      "$pageKey": {
        ".write": "auth != null && root.child('users').child(auth.uid).child('active').val() === true"
      }
    },

    "history": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('active').val() === true",
      "$pageKey": {
        ".write": "auth != null && root.child('users').child(auth.uid).child('active').val() === true && (root.child('users').child(auth.uid).child('role').val() === 'superadmin' || root.child('users').child(auth.uid).child('role').val() === 'approver')"
      }
    },

    "reviews": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('active').val() === true && (root.child('users').child(auth.uid).child('role').val() === 'superadmin' || root.child('users').child(auth.uid).child('role').val() === 'approver')",
      ".indexOn": ["status", "submittedBy/uid"],
      "$reviewId": {
        ".read": "auth != null && data.child('submittedBy/uid').val() === auth.uid",
        ".write": "auth != null && root.child('users').child(auth.uid).child('active').val() === true && (root.child('users').child(auth.uid).child('role').val() === 'superadmin' || root.child('users').child(auth.uid).child('role').val() === 'approver' || (!data.exists() && newData.child('submittedBy/uid').val() === auth.uid) || (data.exists() && data.child('submittedBy/uid').val() === auth.uid && data.child('status').val() === 'pending' && newData.child('status').val() === 'withdrawn'))",
        "status": { ".validate": "newData.val() === 'pending' || newData.val() === 'approved' || newData.val() === 'rejected' || newData.val() === 'withdrawn'" },
        "reviewedBy": { ".validate": "root.child('users').child(auth.uid).child('role').val() === 'superadmin' || root.child('users').child(auth.uid).child('role').val() === 'approver'" },
        "reviewedAt": { ".validate": "root.child('users').child(auth.uid).child('role').val() === 'superadmin' || root.child('users').child(auth.uid).child('role').val() === 'approver'" }
      }
    },

    "userReviews": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'superadmin' || root.child('users').child(auth.uid).child('role').val() === 'approver')",
        ".write": "auth != null && auth.uid === $uid",
        "$reviewId": {
          ".validate": "newData.isBoolean() || !newData.exists()"
        }
      }
    },

    "audit": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('active').val() === true && (root.child('users').child(auth.uid).child('role').val() === 'superadmin' || root.child('users').child(auth.uid).child('role').val() === 'approver')",
      "$ts": {
        ".write": "auth != null && root.child('users').child(auth.uid).child('active').val() === true && !data.exists() && (newData.child('user').val() === auth.token.email || newData.child('user').val() === auth.uid)",
        "action": { ".validate": "newData.val() === 'approve_review' || newData.val() === 'approve_review_delete' || newData.val() === 'bulk_discard' || newData.val() === 'bulk_publish' || newData.val() === 'bulk_rebuild' || newData.val() === 'change_role' || newData.val() === 'deactivate_user' || newData.val() === 'invite_user' || newData.val() === 'publish' || newData.val() === 'reactivate_user' || newData.val() === 'reject_review' || newData.val() === 'restore_history' || newData.val() === 'revert' || newData.val() === 'save_draft' || newData.val() === 'submit_review'" }
      }
    },

    "editing": {
      ".read": "auth != null",
      "$pageKey": {
        ".write": "auth != null",
        "$uid": { ".write": "auth != null && $uid === auth.uid" }
      }
    },

    "content": { ".read": true },
    "_rebuilds": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('active').val() === true",
      "$ts": { ".write": "auth != null && root.child('users').child(auth.uid).child('active').val() === true" }
    }
  }
}
