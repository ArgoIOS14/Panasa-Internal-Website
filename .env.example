# Zoho Bigin CRM Integration
# Used by src/api/zoho-proxy.php and src/api/zoho-email-proxy.php

# OAuth credentials from Zoho API Console (https://api-console.zoho.in/)
ZOHO_CLIENT_ID=your_client_id_here
ZOHO_CLIENT_SECRET=your_client_secret_here

# Long-lived refresh token generated via Zoho OAuth flow
ZOHO_REFRESH_TOKEN=your_refresh_token_here

# Zoho account server URL (varies by data centre)
# India: https://accounts.zoho.in/oauth/v2/token
# US:    https://accounts.zoho.com/oauth/v2/token
# EU:    https://accounts.zoho.eu/oauth/v2/token
ZOHO_ACCOUNTS_URL=https://accounts.zoho.in/oauth/v2/token

# Zoho Bigin API endpoint for Contacts module
# India: https://www.zohoapis.in/bigin/v2/Contacts
# US:    https://www.zohoapis.com/bigin/v2/Contacts
# EU:    https://www.zohoapis.eu/bigin/v2/Contacts
ZOHO_BIGIN_API_URL=https://www.zohoapis.in/bigin/v2/Contacts
